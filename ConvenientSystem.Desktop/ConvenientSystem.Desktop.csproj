<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 桌面应用：WinForms 宿主 + 内嵌 WebView2，需要 Windows 专用 TFM -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinExe 让程序以窗口应用启动，不弹出控制台黑窗 -->
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ConvenientSystem</RootNamespace>
    <AssemblyName>ConvenientSystem</AssemblyName>
    <!-- exe 程序图标 -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <!-- 应用程序清单 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 禁用 CS8618：Entity 类字段由 ORM (FreeSql) 在运行时填充，无需构造函数初始化 -->
    <NoWarn>$(NoWarn);CS8618</NoWarn>
    <!-- 抑制 WebView2 WPF 组件引入的 WindowsBase 版本冲突警告（无害） -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConvenientSystem.Shared\ConvenientSystem.Shared.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <!-- 同时将图标嵌入程序集，供窗口/任务栏图标直接加载 -->
    <EmbeddedResource Include="appicon.ico" LogicalName="appicon.ico" />
    <!-- 锁屏背景图：直接引用前端那份原文件而不是复制一份，
         保证原生锁屏与 Vue 锁屏永远用同一张图，换图时不会只改一边。 -->
    <EmbeddedResource Include="..\web\src\assets\lock-bg.jpg" LogicalName="lock-bg.jpg" />
    <!-- appsettings.json 由 Web SDK 自动包含并复制到输出目录 -->
  </ItemGroup>

  <!-- Release 构建时自动构建 Vue 前端到本项目 wwwroot；Debug 走 vite dev，不触发 npm。
       可用 -p:SkipVueBuild=true 跳过（例如 publish.cmd 已先手动 npm run build）。
       CleanWebAssets 与 BuildVueClient 必须同时受 SkipVueBuild 控制，
       否则 publish.cmd 先 npm run build 产出 assets，dotnet publish 又 Clean 一次导致 assets 被删空。 -->
  <Target Name="CleanWebAssets" BeforeTargets="BuildVueClient" Condition="'$(Configuration)'=='Release' and '$(SkipVueBuild)'!='true'">
    <RemoveDir Directories="$(MSBuildProjectDirectory)\wwwroot\assets" />
    <Delete Files="$(MSBuildProjectDirectory)\wwwroot\index.html" Condition="Exists('$(MSBuildProjectDirectory)\wwwroot\index.html')" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\compressed" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\win-x64\compressed" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\staticwebassets" />
    <RemoveDir Directories="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\win-x64\staticwebassets" />
    <ItemGroup>
      <_OldStaticWebAssets Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\staticwebassets.*" />
      <_OldStaticWebAssets Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\win-x64\staticwebassets.*" />
      <_OldStaticWebAssetCache Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\*.cache" />
      <_OldStaticWebAssetCache Include="$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\win-x64\*.cache" />
    </ItemGroup>
    <Delete Files="@(_OldStaticWebAssets)" />
    <Delete Files="@(_OldStaticWebAssetCache)" />
  </Target>

  <Target Name="BuildVueClient" BeforeTargets="BeforeBuild" Condition="'$(Configuration)'=='Release' and '$(SkipVueBuild)'!='true'">
    <Message Importance="high" Text="[BuildVueClient] 构建 Vue 前端 (web) ..." />
    <Exec Command="npm ci" WorkingDirectory="..\web" Condition="!Exists('..\web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="..\web" />
  </Target>

</Project>
