{
  "manifest_version": 3,
  "name": "便捷系统自动登录",
  "version": "1.0.0",
  "description": "将当前网站登录页交给本机 ConvenientSystem 完成自动登录。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "便捷系统自动登录"
  },
  "permissions": [
    "contextMenus",
    "cookies",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:51942/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
